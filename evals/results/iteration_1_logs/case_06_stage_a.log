from time import monotonic_ns
from evals.cases.case_06.src.retry import call_with_retry

for attempts in (0, -1):
    calls = 0
    def never_called():
        global calls
        calls += 1
    try:
        call_with_retry(never_called, attempts=attempts)
    except BaseException as exc:
        print(f'attempts={attempts}: {type(exc).__name__}: {exc}; calls={calls}')

calls = 0
def deterministic_failure():
    global calls
    calls += 1
    raise ValueError('invalid payload')
try:
    call_with_retry(deterministic_failure, attempts=3)
except Exception as exc:
    print(f'deterministic: {type(exc).__name__}: {exc}; calls={calls}')

times = []
def transient_failure():
    times.append(monotonic_ns())
    raise TimeoutError('still unavailable')
try:
    call_with_retry(transient_failure, attempts=3)
except TimeoutError:
    gaps_us = [(b-a)/1000 for a,b in zip(times,times[1:])]
    print(f'immediate-retry: calls={len(times)}; gaps_us={gaps_us}')
