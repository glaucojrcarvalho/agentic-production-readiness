class CreditLedger:
    def __init__(self) -> None:
        self.entries: list[dict] = []

    def add(self, account_id: str, amount_cents: int, request_id: str) -> dict:
        entry = {
            "id": len(self.entries) + 1,
            "account_id": account_id,
            "amount_cents": amount_cents,
            "request_id": request_id,
        }
        self.entries.append(entry)
        return dict(entry)


def issue_credit(
    ledger: CreditLedger,
    actor_account_id: str,
    target_account_id: str,
    amount_cents: int,
    request_id: str,
) -> dict:
    if amount_cents <= 0:
        raise ValueError("amount_cents must be positive")

    return ledger.add(target_account_id, amount_cents, request_id)
from evals.cases.case_12.src.credits import CreditLedger, issue_credit


def test_account_can_receive_credit() -> None:
    ledger = CreditLedger()

    entry = issue_credit(
        ledger,
        actor_account_id="acct-a",
        target_account_id="acct-a",
        amount_cents=2500,
        request_id="req-1",
    )

    assert entry["account_id"] == "acct-a"
    assert entry["amount_cents"] == 2500

