from datetime import datetime, timedelta, timezone
from evals.cases.case_10.src.tokens import is_token_expired

utc = timezone.utc
plus_two = timezone(timedelta(hours=2))
cases = [
    (\"missed expiration\", datetime(2026, 8, 28, 13, 0, tzinfo=plus_two), datetime(2026, 8, 28, 12, 0, tzinfo=utc)),
    (\"premature expiration\", datetime(2026, 8, 28, 12, 0, tzinfo=utc), datetime(2026, 8, 28, 13, 0, tzinfo=plus_two)),
]
for label, expires_at, now in cases:
    expected = now >= expires_at
    actual = is_token_expired(expires_at, now)
    print(f\"{label}: expires={expires_at.isoformat()} now={now.isoformat()} expected={expected} actual={actual}\")
