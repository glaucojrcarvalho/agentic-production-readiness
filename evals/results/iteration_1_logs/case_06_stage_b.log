from collections.abc import Callable


def call_with_retry(operation: Callable[[], object], attempts: int = 3) -> object:
    last_error: Exception | None = None

    for _ in range(attempts):
        try:
            return operation()
        except Exception as exc:
            last_error = exc

    assert last_error is not None
    raise last_error
evals/cases/case_06/tests/test_retry.py
from evals.cases.case_06.src.retry import call_with_retry


def test_transient_failure_can_recover() -> None:
    calls = 0

    def operation() -> str:
        nonlocal calls
        calls += 1
        if calls < 2:
            raise TimeoutError("temporary")
        return "ok"

    assert call_with_retry(operation) == "ok"
    assert calls == 2
