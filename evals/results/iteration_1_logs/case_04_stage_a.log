from concurrent.futures import ThreadPoolExecutor
from evals.cases.case_04.src.inventory import Inventory

for attempt in range(5):
    inventory = Inventory({'sku-1': 1})
    with ThreadPoolExecutor(max_workers=2) as pool:
        outcomes = list(pool.map(lambda _: inventory.reserve('sku-1', 1), range(2)))
    print({'attempt': attempt + 1, 'outcomes': outcomes, 'available': inventory.available('sku-1')})
